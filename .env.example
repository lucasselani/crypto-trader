# Copie para .env. Nunca commite o .env.

# Exchange usada pelo ccxt (dados e ordens)
TRADER_EXCHANGE=binance

# paper   = simulador local (sem chave, dinheiro fictício)
# testnet = Binance Spot Testnet (chave em https://testnet.binance.vision)
# live    = conta real (exige também TRADER_ALLOW_LIVE=yes)
TRADER_MODE=paper
TRADER_ALLOW_LIVE=no

# Chaves da testnet ou da conta real (só leitura + spot trading; NUNCA habilite saque)
TRADER_API_KEY=
TRADER_API_SECRET=

# Universo e timeframe do swing
TRADER_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TRADER_TIMEFRAME=1d
TRADER_STRATEGY=donchian

# Risco
TRADER_RISK_PER_TRADE=0.01
TRADER_MAX_POSITION_PCT=0.30
TRADER_MAX_OPEN_POSITIONS=3
TRADER_MAX_DRAWDOWN=0.20

# Custos usados no backtest e no paper
TRADER_FEE_RATE=0.001
TRADER_SLIPPAGE=0.0005

# Saldo inicial do modo paper (na moeda de cotação, ex.: USDT)
TRADER_PAPER_CASH=10000

TRADER_DATA_DIR=data
TRADER_STATE_DIR=state
